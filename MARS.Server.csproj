    <ItemGroup>
      <EditorConfigFiles Remove="D:\VS\TestScripts\MARS\MARS.Server\.editorconfig" />
    </ItemGroup>

    <ItemGroup>
      <None Include="D:\VS\TestScripts\MARS\MARS.Server\.editorconfig" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Services\SoundRequest\Platforms\SoundCloud\" />
      <Folder Include="Services\SoundRequest\Platforms\YouTube\" />
      <Folder Include="Services\TabletopGames\Entitys\Enums\" />
    </ItemGroup>



    <Target Name="BuildClientApp" BeforeTargets="Build">
        <Message Importance="high" Text="Сборка фронта через yarn build..." />
        <Exec WorkingDirectory="..\mars.client" Command="yarn install" />
        <Exec WorkingDirectory="..\mars.client" Command="yarn build" />
    </Target>

    <Target Name="CopyClientDistToWwwroot" AfterTargets="Build">
        <Message Importance="high" Text="Копирование dist в wwwroot..." />
        <RemoveDir Directories="wwwroot/assets/**/*" />
        <Copy SourceFiles="@(DistFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <DistFiles Include="..\mars.client\dist\**\*" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="HuTao.NET">
        <HintPath>..\..\..\HuTao.NET\HuTao.NET\bin\Debug\net8.0\HuTao.NET.dll</HintPath>
      </Reference>
    </ItemGroup>


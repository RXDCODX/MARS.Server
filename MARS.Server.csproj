        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
            <Version>9.*-*</Version>
        </PackageReference>
        <PackageReference Include="DSharpPlus" Version="4.5.1" />
        <PackageReference Include="DSharpPlus.Rest" Version="4.5.1" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.8" />
        <PackageReference Include="Microsoft.AspNetCore.WebSockets" Version="2.3.0" />
        <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.45.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f9a82fce-305c-4001-bb58-713dc08d3aa9</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <WarningsAsErrors>CS0618</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress analyzer errors from external dependencies -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <!-- SpaYarp configuration -->
    <SpaRoot>../mars.client</SpaRoot>
    <SpaClientUrl>http://localhost:44478</SpaClientUrl>
    <SpaLaunchCommand>yarn dev</SpaLaunchCommand>
    <OpenApiExportOnRun>false</OpenApiExportOnRun>
    <RunArguments Condition="'$(OpenApiExportOnRun)' == 'true' and '$(RunArguments)' == ''">--generate-openapi</RunArguments>
    <RunArguments Condition="'$(OpenApiExportOnRun)' == 'true' and '$(RunArguments)' != ''">$(RunArguments) --generate-openapi</RunArguments>
    <!-- Change the timeout of the proxy (defaults to 120 seconds) -->
    <SpaProxyTimeoutInSeconds>1200</SpaProxyTimeoutInSeconds>
    <!-- Optionally forward only request starting with the specified path -->
    <!--<SpaPublicPath>/dist</SpaPublicPath>-->
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'" />

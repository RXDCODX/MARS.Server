    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Update="appsettings.Production.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Update="!create_service.bat">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="!delete_service.bat">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Update="AutoHelloMessages.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <EditorConfigFiles Remove="D:\VS\TestScripts\MARS\MARS.Server\.editorconfig" />
    </ItemGroup>

    <ItemGroup>
      <None Include="D:\VS\TestScripts\MARS\MARS.Server\.editorconfig" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Services\CommandExecutor\Commands\TwitchOnly\" />
      <Folder Include="Services\SoundRequest\Platforms\SoundCloud\" />
      <Folder Include="Services\SoundRequest\Platforms\YouTube\" />
      <Folder Include="Services\TabletopGames\Entitys\Enums\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="api.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>api.yaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <Target Name="BuildClientApp" BeforeTargets="Build">
        <Message Importance="high" Text="Сборка фронта через yarn build..." />
        <Exec WorkingDirectory="..\mars.client" Command="yarn install" />
        <Exec WorkingDirectory="..\mars.client" Command="yarn build" />
    </Target>

    <Target Name="CopyClientDistToWwwroot" AfterTargets="Build">
        <Message Importance="high" Text="Копирование dist в wwwroot..." />
        <RemoveDir Directories="wwwroot\assets" />

        <ItemGroup>
            <DistFiles Include="..\mars.client\dist\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(DistFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
    
    <Target Name="CopyClientDistToPublishWwwroot" AfterTargets="Publish">
        <Message Importance="high" Text="Копирование dist в опубликованный wwwroot..." />
        <RemoveDir Directories="$(PublishDir)wwwroot\assets" />

        <ItemGroup>
            <DistFiles Include="..\mars.client\dist\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(DistFiles)" DestinationFolder="$(PublishDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>